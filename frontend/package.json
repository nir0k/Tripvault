    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "daisyui": "5.7.38",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
