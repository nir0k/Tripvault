# Tripvault production configuration.
#
#   cp .env.example .env
#
# The required values have no defaults on purpose: docker compose refuses to
# start until they are set.

# --- Required ---------------------------------------------------------------

# PostgreSQL password:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Key that signs session tokens, at least 32 characters. Anyone who knows it can
# act as any account. Changing it signs everybody out.
#   openssl rand -base64 48
TRIPVAULT_AUTH_JWT_SECRET=

# --- First administrator ----------------------------------------------------

# Created on the first start, when the database has no accounts yet, and never
# touched again: later changes to these values do nothing. Nobody can sign up on
# their own, so without them a new instance has no way in. The password must be
# at least 8 characters; remove it from this file once you have signed in.
TRIPVAULT_ADMIN_EMAIL=
TRIPVAULT_ADMIN_PASSWORD=

# --- Routes -----------------------------------------------------------------

# Which service calculates road routes:
#   ors       openrouteservice, hosted, needs a key (free at
#             https://account.heigit.org)
#   osrm      a Project OSRM server of your own
#   valhalla  a Valhalla server of your own
TRIPVAULT_ROUTING_PROVIDER=ors

# Where that service is. Left empty it means openrouteservice's own address,
# https://api.heigit.org/openrouteservice; a server of your own has no default
# and must be given one, such as http://osrm:5000.
TRIPVAULT_ROUTING_BASE_URL=

# The key, for a service that asks for one. Without it road legs are
# straight-line estimates, marked as such in the interface; a server of your own
# usually needs no key at all.
TRIPVAULT_ROUTING_API_KEY=

# How many requests the service sends follows from the address: it stays under
# the openrouteservice standard plan, and under the one request a second the
# OSRM demo server asks for; a server of your own is not limited. When the
# daily limit is reached new legs become estimates.

# --- Place search -------------------------------------------------------------

# Which service finds places:
#   pelias     the geocoder behind openrouteservice, hosted, needs the same kind
#              of key
#   photon     a Photon server of your own
#   nominatim  a Nominatim server of your own, or the public one - mind its
#              usage policy of one request a second
TRIPVAULT_GEOCODING_PROVIDER=pelias

# Where that service is. Left empty it means https://api.heigit.org/pelias/v1;
# a server of your own must be given an address, such as http://photon:2322.
TRIPVAULT_GEOCODING_BASE_URL=

# The key, for a service that asks for one. Without it a point is still placed
# by coordinates, a map link or a click on the map; only searching is off.
TRIPVAULT_GEOCODING_API_KEY=

# Counted separately from the routes, and limited the same way: under the
# Pelias standard plan, under one request a second on the public Nominatim, not
# at all on a server of your own.

# --- Map --------------------------------------------------------------------

# Raster tiles the browser draws maps with, as a template with {z}, {x} and {y}.
# The server fetches the same tiles to draw the maps of a report's PDF, so it
# needs to reach this address too; it keeps each tile for 30 days in the
# database, outside the backups. Without the tiles the PDF's maps are drawn on
# plain paper.
#
# The default is the OpenStreetMap servers, whose usage policy allows light use
# only (https://operations.osmfoundation.org/policies/tiles/). They also refuse
# some networks outright, and a refused tile arrives as a picture reading
# "access blocked" - so a map of grey squares with that text on them is this
# setting to change, not a fault in the service.
#
# These two need no key and are free with attribution:
#   https://tile.openstreetmap.de/{z}/{x}/{y}.png   the same map, another server
#   https://tile.opentopomap.org/{z}/{x}/{y}.png    contours and hillshading
# Carto, MapTiler, Thunderforest and Stadia Maps give you an address with a key
# in it, for heavier use. A server of your own goes here like any other.
#
# Judge a server by the picture it sends rather than by the status it answers
# with: one that wants a key answers 200 and writes "API key required" across
# every tile, and one that refuses your network answers 200 with "access
# blocked". Open the map and look at it.
TRIPVAULT_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Whose data the map shows, as the provider asks it to be credited. It may hold
# links and is sanitised before it is displayed.
TRIPVAULT_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# The interface loads tiles from https addresses only. A server of your own on
# plain http is refused by that policy until its origin is named here, such as
# http://tiles.lan:8080 - the one exception, and only for images.
TRIPVAULT_MAP_TILE_ORIGIN=

# --- Media ------------------------------------------------------------------

# The photographs of a trip live in the tripvault-media volume. The first limit
# bounds one photograph. The second seeds the per-trip quota when this instance
# has no stored setting yet; administrators change it later on the service
# status page, and zero leaves a trip unlimited. An imported GPX or KML track
# and an attachment of a place - a ticket, a booking - are limited to 10 MB
# each; both count towards the trip's quota like a photograph.
TRIPVAULT_MEDIA_MAX_SIZE_MB=25
TRIPVAULT_MEDIA_TRIP_QUOTA_MB=2048

# The operator's ceiling for user files across the whole instance: original
# photographs, avatars, idea photos, attachments and imported tracks. Generated
# previews, database housekeeping, caches and backup archives are not charged.
# 0 leaves the instance unlimited. The per-trip quota above becomes editable
# in Administration after its initial value is created from this file.
TRIPVAULT_STORAGE_QUOTA_MB=0

# --- Mail -------------------------------------------------------------------

# SMTP is optional. Set the host, sender and public URL together to make mail
# available; an administrator then enables delivery on the service status page.
# Credentials stay in this operator-owned file and are never stored in the
# database. TLS is starttls (the usual port 587), tls (usually port 465), or
# none for a trusted local relay without authentication.
TRIPVAULT_MAIL_HOST=
TRIPVAULT_MAIL_PORT=587
TRIPVAULT_MAIL_USERNAME=
TRIPVAULT_MAIL_PASSWORD=
TRIPVAULT_MAIL_TLS=starttls
TRIPVAULT_MAIL_FROM_ADDRESS=
TRIPVAULT_MAIL_FROM_NAME=Tripvault
TRIPVAULT_MAIL_PUBLIC_URL=

# --- Backups ----------------------------------------------------------------

# Where archives go, how often they are kept and with what passphrase is set in
# the interface, under Administration. Archives written to this server's own
# disk live in the tripvault-backups volume; a second configuration writing to
# another machine over SFTP is what survives losing this one.
#
# Archives never pass through the browser. A restore, also under
# Administration, reads one back from the volume or the SFTP server; an archive
# from elsewhere is copied into the volume on the host first, or restored before
# the service starts with `tripvault-backend --restore <archive>`.

# Seals the credentials entered in the backup settings - an SFTP password or
# key, and the passphrase archives are locked with - so a dump of the database
# alone opens none of them. Left empty, the service makes a key in the
# tripvault-config volume on its first start and reads it from there afterwards;
# set it only to keep the key in your own secret store:
#   docker run --rm ghcr.io/nir0k/tripvault-backend:latest --secrets-key
TRIPVAULT_SECRETS_KEY=

# --- Published address ------------------------------------------------------

# The web interface listens on localhost only, expecting a reverse proxy or a
# Cloudflare Tunnel in front. Use 0.0.0.0 to expose it on the network directly.
TRIPVAULT_BIND_ADDRESS=127.0.0.1
TRIPVAULT_HTTP_PORT=8080

# The address or network (CIDR) of that reverse proxy or tunnel, as the
# frontend container sees it. Sign-in attempts are counted per client, and
# behind a proxy every client arrives from the proxy's address: until it is
# named here, wrong passwords from one visitor lock everybody out for a while.
# A proxy or cloudflared on the Docker host reaches the container from the
# Docker network's gateway, so 172.16.0.0/12 covers the default networks. The
# client is then taken from X-Forwarded-For, which that proxy must set.
TRIPVAULT_TRUSTED_PROXY=127.0.0.1/32

# --- Images -----------------------------------------------------------------

# "latest" follows the newest release; pin a version (e.g. 1.0.0) to decide
# when upgrades happen.
TRIPVAULT_VERSION=latest

# --- Database ---------------------------------------------------------------

POSTGRES_DB=tripvault
POSTGRES_USER=tripvault

# --- Sessions -----------------------------------------------------------------

# How long somebody stays signed in without signing in again; 720h is thirty
# days.
TRIPVAULT_AUTH_REFRESH_TOKEN_TTL=720h

# --- Logging ----------------------------------------------------------------

# debug, info, warn or error. The format is always logfmt on stdout.
TRIPVAULT_LOG_LEVEL=info
