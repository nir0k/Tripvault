# Test stand configuration.
#
# Committed on purpose: every value is a throwaway placeholder for a stand whose
# data is destroyed on "docker compose down". Every variable also has a default
# in docker-compose.yaml, so the stand starts without this file.
#
# Never reuse these values in a real deployment; see the repository root's
# docker-compose.yaml and .env.example for that.

# --- Host ports (bound to 127.0.0.1) ----------------------------------------
TRIPVAULT_WEB_PORT=8071
TRIPVAULT_API_PORT=8070

# The proxy in front of the web port whose X-Forwarded-For names the real
# client; the stand is opened directly, so nobody is trusted.
TRIPVAULT_TRUSTED_PROXY=127.0.0.1/32

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=tripvault
POSTGRES_USER=tripvault
POSTGRES_PASSWORD=tripvault

# --- Backend ----------------------------------------------------------------
# One of: debug, info, warn, error. The format is always logfmt.
TRIPVAULT_LOG_LEVEL=debug
TRIPVAULT_AUTH_JWT_SECRET=stand-only-not-a-real-secret

# The first administrator, created on the stand's first start.
TRIPVAULT_ADMIN_EMAIL=admin@example.com
TRIPVAULT_ADMIN_PASSWORD=Samsung1
TRIPVAULT_ADMIN_DISPLAY_NAME=Administrator

# How long a session lasts, and how many connections the service opens to the
# database. The stand runs with the same values a real deployment starts with.
TRIPVAULT_AUTH_ACCESS_TOKEN_TTL=15m
TRIPVAULT_AUTH_REFRESH_TOKEN_TTL=720h
TRIPVAULT_DB_MAX_CONNS=10

# Two example trips - one travelled and written up, one still being planned -
# created on an empty database. They belong to the administrator above and bring
# two more accounts, editor@example.com and viewer@example.com, whose password is
# printed in the backend's log. Set to false for an empty stand.
TRIPVAULT_DEMO_DATA=true

# --- Map ----------------------------------------------------------------------
# The tiles the browser draws maps with. Empty means the OpenStreetMap servers,
# whose usage policy allows light use only - and which refuse some networks
# outright, sending a picture that reads "access blocked" in place of every tile.
#
# The stand uses the German OpenStreetMap style instead: the same map, a server
# that answers, and no key. OpenTopoMap is the other one tried here and works
# too, if you would rather read contours:
#
#   https://tile.opentopomap.org/{z}/{x}/{y}.png
#
# A tile that costs nothing is still a tile somebody serves: whichever you use,
# credit it in the attribution. And judge a server by the picture it sends, not
# by the status it answers with - one that wants a key answers 200 and writes
# "API key required" across the map.
TRIPVAULT_MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
TRIPVAULT_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, tiles by <a href="https://www.fossgis.de/">FOSSGIS</a>

# A tile server of your own usually runs on plain http, which the page is not
# allowed to load images from until its origin is named here, such as
# http://tiles.lan:8080.
TRIPVAULT_MAP_TILE_ORIGIN=

# --- Routes and place search ---------------------------------------------------
# Which services calculate routes and find places, and how they are reached.
#
# The stand routes through the OSRM project's own demo server: no key, real
# roads on the map instead of straight lines. It is meant for development and
# trying things out, not for a service people use - a real deployment gets an
# openrouteservice key, or an OSRM of its own:
#
#   TRIPVAULT_ROUTING_PROVIDER=ors                 TRIPVAULT_ROUTING_API_KEY=...
#   TRIPVAULT_ROUTING_PROVIDER=osrm                TRIPVAULT_ROUTING_BASE_URL=http://osrm:5000
#
# The limits are what this service allows itself; they are kept low here because
# the demo server is somebody else's machine.
TRIPVAULT_ROUTING_PROVIDER=osrm
TRIPVAULT_ROUTING_BASE_URL=https://router.project-osrm.org
TRIPVAULT_ROUTING_API_KEY=
TRIPVAULT_ROUTING_REQUESTS_PER_MINUTE=20
TRIPVAULT_ROUTING_DAILY_LIMIT=2000
TRIPVAULT_ROUTING_CACHE_TTL=2160h

# Place search through the public Nominatim of OpenStreetMap, which the map's
# tiles come from too: no key needed. Its usage policy allows one request a
# second, so the stand asks for less than that; the cache takes repeats.
TRIPVAULT_GEOCODING_PROVIDER=nominatim
TRIPVAULT_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
TRIPVAULT_GEOCODING_API_KEY=
TRIPVAULT_GEOCODING_REQUESTS_PER_MINUTE=50
TRIPVAULT_GEOCODING_DAILY_LIMIT=0
TRIPVAULT_GEOCODING_CACHE_TTL=720h

# --- Media ----------------------------------------------------------------------
# What one upload, one trip and one imported track may take. The stand keeps
# them inside the container, so they die with it.
TRIPVAULT_MEDIA_MAX_SIZE_MB=25
TRIPVAULT_MEDIA_TRIP_QUOTA_MB=2048
TRIPVAULT_MEDIA_TRACK_MAX_SIZE_MB=10

# --- Backups --------------------------------------------------------------------
# Backups work on the stand and are written inside the container. The secrets
# key that seals their credentials is made there too, and goes the same way.
TRIPVAULT_BACKUP_SCHEDULER_INTERVAL=1m

# --- Build ------------------------------------------------------------------
# The version stamped into the stand's images. Unset, it is "stand".
# TRIPVAULT_VERSION=0.0.1
